diff --git a/app/tests/hold-tap/hold-preferred/9-retro-shift/native_posix_64.keymap b/app/tests/hold-tap/hold-preferred/9-retro-shift/native_posix_64.keymap
new file mode 100644
index 0000000..89ad973
--- /dev/null
+++ b/app/tests/hold-tap/hold-preferred/9-retro-shift/native_posix_64.keymap
@@ -0,0 +1,52 @@
+#include <dt-bindings/zmk/keys.h>
+#include <behaviors.dtsi>
+#include <dt-bindings/zmk/kscan_mock.h>
+
+/ {
+    behaviors {
+        ht_rs: behavior_retro_shift {
+            compatible = "zmk,behavior-hold-tap";
+            #binding-cells = <2>;
+            flavor = "hold-preferred";
+            tapping-term-ms = <175>;
+            bindings = <&kp>, <&kp>;
+            retro-tap;
+            retro-shift-ms = <500>;
+        };
+    };
+
+    keymap {
+        compatible = "zmk,keymap";
+
+        default_layer {
+            bindings = <
+                &ht_rs LEFT_CONTROL A &none
+                &kp D &none>;
+        };
+    };
+};
+
+
+&kscan {
+    events = <
+        /* tap: a */
+        ZMK_MOCK_PRESS(0,0,10)
+        ZMK_MOCK_RELEASE(0,0,10)
+        /* lone hold within retro-shift-ms: A */
+        ZMK_MOCK_PRESS(0,0,300)
+        ZMK_MOCK_RELEASE(0,0,10)
+        /* lone hold beyond retro-shift-ms: nothing */
+        ZMK_MOCK_PRESS(0,0,600)
+        ZMK_MOCK_RELEASE(0,0,10)
+        /* hold past tapping term, then another key: ctrl+d */
+        ZMK_MOCK_PRESS(0,0,300)
+        ZMK_MOCK_PRESS(1,0,10)
+        ZMK_MOCK_RELEASE(1,0,10)
+        ZMK_MOCK_RELEASE(0,0,10)
+        /* another key within tapping term: ctrl+d */
+        ZMK_MOCK_PRESS(0,0,50)
+        ZMK_MOCK_PRESS(1,0,10)
+        ZMK_MOCK_RELEASE(1,0,10)
+        ZMK_MOCK_RELEASE(0,0,10)
+    >;
+};
